# Server Configuration
PORT=5002
HOST=0.0.0.0
NODE_ENV=production

# Storage Configuration
DEFAULT_STORAGE_PATH=/Volumes/UBUNTU 24_0/360Photo_Captures

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5002

# Python Environment
PYTHON_VENV_PATH=.venv/bin/python3

# Logging
LOG_LEVEL=info

GEMINI_API_KEY=your_gemini_api_key_here

# Camera Settings (optional overrides)
# CAMERA_INDEX=0
# CAMERA_WIDTH=1920
# CAMERA_HEIGHT=1080
# CAMERA_FPS=30

# Session Defaults
# DEFAULT_CAPTURE_RATE=160
# DEFAULT_CAPTURE_DURATION=120
